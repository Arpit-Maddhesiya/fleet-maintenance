// Prisma schema for Fleet Maintenance
// Provider is postgresql — the database URL points at the Neon serverless Postgres.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  FLEET_MANAGER
  TECHNICIAN
}

enum ServiceStatus {
  DUE
  BOOKED
  IN_SERVICE
  COMPLETED
}

enum HistoryEventType {
  CREATED
  STATUS_CHANGE
  ASSIGNED
  UNASSIGNED
  NOTE
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String
  role           Role
  createdAt      DateTime @default(now())
  assignments    ServiceAssignment[]
  historyEvents  ServiceHistoryEvent[]
  assignedEvents ServiceHistoryEvent[] @relation("EventTechnician")
  dismissedAlerts Alert[]  @relation("AlertDismissedBy")

  @@index([role])
}

model Vehicle {
  id                  String             @id @default(cuid())
  registrationNumber  String             @unique
  make                String
  model               String
  currentOdometer     Int
  dateIntervalDays    Int
  mileageInterval     Int
  lastServiceDate     DateTime?
  lastServiceOdometer Int?
  serviceCycle        Int                @default(1)
  archivedAt          DateTime?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt
  serviceRecords      ServiceRecord[]
  alerts              Alert[]

  @@index([archivedAt])
}

model ServiceRecord {
  id                String              @id @default(cuid())
  vehicleId         String
  vehicle           Vehicle             @relation(fields: [vehicleId], references: [id])
  description       String
  status            ServiceStatus       @default(DUE)
  scheduledDate     DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  completedOdometer Int?
  dueSince          DateTime            @default(now())
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  assignments       ServiceAssignment[]
  historyEvents     ServiceHistoryEvent[]

  @@index([vehicleId])
  @@index([status])
  @@index([scheduledDate])
  @@index([updatedAt])
}

model ServiceAssignment {
  id              String        @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord @relation(fields: [serviceRecordId], references: [id])
  technicianId    String
  technician      User          @relation(fields: [technicianId], references: [id])
  assignedAt      DateTime      @default(now())
  unassignedAt    DateTime?

  @@index([technicianId])
  @@index([serviceRecordId])
}

model ServiceHistoryEvent {
  id              String            @id @default(cuid())
  serviceRecordId String
  serviceRecord   ServiceRecord     @relation(fields: [serviceRecordId], references: [id])
  type            HistoryEventType
  fromStatus      ServiceStatus?
  toStatus        ServiceStatus?
  note            String?
  actorId         String
  actor           User              @relation(fields: [actorId], references: [id])
  // Which technician an ASSIGNED/UNASSIGNED event refers to (null for other
  // event types). Captured at write time so the audit timeline can name the
  // technician without guessing from the assignment history.
  technicianId    String?
  technician      User?             @relation("EventTechnician", fields: [technicianId], references: [id])
  createdAt       DateTime          @default(now())

  @@index([serviceRecordId, createdAt])
}

model Alert {
  id             String   @id @default(cuid())
  vehicleId      String
  vehicle        Vehicle  @relation(fields: [vehicleId], references: [id])
  serviceCycle   Int
  triggeredAt    DateTime @default(now())
  dismissedAt    DateTime?
  dismissedById  String?
  dismissedBy    User?    @relation("AlertDismissedBy", fields: [dismissedById], references: [id])

  @@unique([vehicleId, serviceCycle])
  @@index([vehicleId])
}
